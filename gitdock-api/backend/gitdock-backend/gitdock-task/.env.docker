# ==============================================================================
# gitdock-task (Symfony) — Environnement Docker (NE PAS COMMITER !)
# ==============================================================================

# 1. MODE DÉVELOPPEMENT ACTIVÉ (Pour voir les erreurs !)
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=6499ab47e4f045b9b4d46b154b1d0671

# 2. BASE DE DONNÉES ET MESSAGERIE (Routage Docker Interne)
DATABASE_URL="mysql://root:root@gitdock-mysql:3306/gitdock_tasks?serverVersion=8.0.32&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@gitdock-rabbitmq:5672/%2f

# 3. COMMUNICATIONS INTER-SERVICES (⚠️ Plus de localhost ici !)
AUTH_SERVICE_URL=http://auth-service:8081
PROJECT_SERVICE_URL=http://gitdock-project:8083

# 4. MAILS (Laissés à gitdock-notification via RabbitMQ)
MAILER_DSN=null://null

# 5. JWT (Pour décoder les requêtes)
JWT_SECRET_KEY=/var/www/html/config/jwt/private.pem
JWT_PUBLIC_KEY=/var/www/html/config/jwt/public.pem
JWT_PASSPHRASE=575d383a693b8bb6a0d14cf2f22c7794ebd67d6a56d1e941c72005329a0aa77a
